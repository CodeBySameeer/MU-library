# MU Library Chat backend — environment template
# Copy to `.env` and fill in real values.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Comma-separated list of allowed origins for CORS.
# In production, list your real domain(s) only.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173